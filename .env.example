PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret

# Creator access. Set this to your own login email before deployment.
ADMIN_EMAILS=your-email@example.com

# Registration gate. Friends cannot create accounts without a valid invite.
REQUIRE_INVITE_CODE=true

# Use this once to create your creator account, then keep it private.
OWNER_INVITE_CODE=replace-with-a-private-creator-code

# AI backend. Keep this only on the server, never in browser code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local development uses a JSON data file.
STUDYBRIDGE_DB=local
LOCAL_DB_FILE=.data/studybridge.json

# AWS production can use DynamoDB.
# STUDYBRIDGE_DB=dynamodb
# AWS_REGION=us-east-1
# DYNAMODB_TABLE=StudyBridge
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
