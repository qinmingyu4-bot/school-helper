PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret
APP_BASE_URL=http://localhost:3000

# Creator access. Set this to your own login email before deployment.
ADMIN_EMAILS=your-email@example.com

# Registration is open. An optional valid one-use invite grants Plus membership.
# Legacy REQUIRE_INVITE_CODE values are ignored; they no longer gate signup.

# Use this once to create your creator account, then keep it private.
OWNER_INVITE_CODE=replace-with-a-private-creator-code

# Optional Google sign-in. Keep normal email/password registration enabled too.
# Set this redirect URI in Google Cloud:
#   http://localhost:3000/api/auth/google/callback
# Production StudyBridge callback:
#   https://studybridge.ink/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional explicit callback (otherwise derived from APP_BASE_URL / request):
GOOGLE_REDIRECT_URI=

# Read-only mailbox connections, separate from Google sign-in. See docs/mailbox-assistant.md.
# Keep a stable random 32-byte base64 key in private server configuration.
MAILBOX_ENCRYPTION_KEY=
# Gmail can reuse GOOGLE_CLIENT_ID/SECRET, with this ADDITIONAL registered callback:
# https://studybridge.ink/api/mailbox/gmail/callback
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
# Microsoft app registration: work/school AND personal Microsoft accounts.
# https://studybridge.ink/api/mailbox/outlook/callback
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=
MAILBOX_SYNC_INTERVAL_SECONDS=300
MAILBOX_SYNC_DISABLED=false

# Require a delivered 6-digit code before email/password registration.
# Existing accounts keep password login; Google confirms its own verified emails.
REQUIRE_EMAIL_VERIFICATION=true
EMAIL_CODE_TTL_MINUTES=15
# Local test fallback must be explicitly enabled; always ignored in production.
ALLOW_EMAIL_CODE_FALLBACK=false

# SMTP email delivery. Gmail can work with an app password; production apps often use SendGrid, Mailgun, or AWS SES SMTP.
SMTP_HOST=email-smtp.ca-central-1.amazonaws.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=replace-with-ses-smtp-username
SMTP_PASS=replace-with-smtp-or-app-password
MAIL_FROM="StudyBridge <noreply@studybridge.ink>"

# AI backend. Keep this only on the server, never in browser code.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_SIMPLE_MODEL=gpt-6-luna
OPENAI_COMPLEX_MODEL=gpt-6.1-sol
# Basic review/readable simple questions use Luna; demanding/unknown questions use Sol.
# Background problem sets group simple and complex questions separately (no fixed ratio).
# Allow StudyBridge AI to use live web lookup for current facts.
OPENAI_WEB_SEARCH=true
OPENAI_DOCUMENT_MODEL=gpt-6.1-sol
OPENAI_IMAGE_MODEL=gpt-image-2
# Prepared but closed to users; do not enable without an approved video launch.
STUDYBRIDGE_VIDEO_ENABLED=false
OPENAI_VIDEO_MODEL=sora-2
# Web requests use the selected simple/complex model.
# Legacy OPENAI_SOL_ROUTE_PERCENT and OPENAI_WEB_MODEL are ignored.

# Subscription foundation. Keep disabled until a Stripe test account is configured.
# Only disabled/test are accepted; live keys and live events are rejected.
BILLING_MODE=disabled
BILLING_PUBLIC_BASE_URL=http://localhost:3000
BILLING_MONTHLY_AMOUNT_CENTS=1999
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLUS_MONTHLY_PRICE_ID=
# Optional test Customer Portal configuration (payment methods/invoices/cancellation).
STRIPE_PORTAL_CONFIGURATION_ID=

# Local development uses a JSON data file.
STUDYBRIDGE_DB=local
LOCAL_DB_FILE=.data/studybridge.json
LOCAL_DB_BACKUP_DIR=.data/backups
LOCAL_DB_BACKUP_INTERVAL_HOURS=6
LOCAL_DB_BACKUP_RETENTION=72
LOCAL_DB_BACKUP_DISABLED=false

# AWS production can use DynamoDB.
# STUDYBRIDGE_DB=dynamodb
# AWS_REGION=us-east-1
# DYNAMODB_TABLE=StudyBridge
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
